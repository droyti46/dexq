{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "DEXQ frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "DEXQ backend",
      "runtimeExecutable": "backend/.venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
